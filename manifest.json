{
  "manifest_version": 3,
  "name": "도파민 멈춰!",
  "version": "0.1.0",
  "description": "Block distracting sites by scheduled time and daily usage limit. No bypass.",

  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "tabs"
  ],

  "optional_host_permissions": [
    "<all_urls>"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default_rules",
        "enabled": false,
        "path": "rules/default_rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
